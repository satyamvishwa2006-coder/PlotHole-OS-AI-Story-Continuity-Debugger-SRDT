# PlotHole OS - Environment Configuration
# Add your Google Gemini API Key below
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default AI Model (e.g. gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Application settings
APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./plothole.db
