# PlotHole OS - Environment Configuration Example
# Add your NVIDIA API Key below (get one at https://build.nvidia.com/)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Configurable NVIDIA NIM Model (e.g. minimaxai/minimax-m3.1-flash, google/gemma-4-31b-it)
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash

# Application settings
APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./plothole.db
